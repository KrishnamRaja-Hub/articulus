{
  "name": "articulus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch": "node scripts/fetch-assist.ts",
    "renormalize": "node scripts/renormalize.ts",
    "validate:data": "node scripts/validate-data.ts",
    "validate:data:ci": "node scripts/validate-data.ts --mode=ci",
    "mock:assist": "node scripts/pipeline/mock-assist.ts",
    "test:independent": "vitest run tests/independent",
    "test:independent:full": "INDEPENDENT_BUDGET=full vitest run tests/independent",
    "typecheck:tests": "tsc -p tests/independent"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
